{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidal",
  "version": "0.1.0",
  "identifier": "com.abhishek-vankar.tidal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "https://tidal.com/",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "https://tidal.com/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}